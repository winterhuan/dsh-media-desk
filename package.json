{
  "name": "@winterhuan/dsh-media-desk",
  "version": "2.6.2-winter.1",
  "description": "DeepSeek Harness 插件。一句话记灵感，一键成稿：口播脚本、标题、视频封面、配图和黑白线稿分镜。",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./native-context": "./src/native-context.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-media-desk.git"
  },
  "homepage": "https://github.com/winterhuan/dsh-media-desk#readme",
  "bugs": "https://github.com/winterhuan/dsh-media-desk/issues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check-syntax.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js",
    "assets": "python3 scripts/gen-assets.py",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "esbuild": "^0.25.10",
    "ws": "8.18.3"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent-instructions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-command-compact": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1",
    "@deepseek-ai/dsh-time-context": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-web": "0.2.2-rc.1"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "GUIDE.md",
    "GUIDE.zh.md"
  ]
}
