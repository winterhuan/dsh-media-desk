{
  "name": "@winterhuan/dsh-media-desk",
  "version": "2.6.2-winter.1",
  "description": "DeepSeek Harness 插件。一句话记灵感，一键成稿：口播脚本、标题、视频封面、配图和黑白线稿分镜。",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-media-desk.git"
  },
  "homepage": "https://github.com/winterhuan/dsh-media-desk#readme",
  "bugs": "https://github.com/winterhuan/dsh-media-desk/issues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check-syntax.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js",
    "assets": "python3 scripts/gen-assets.py",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "GUIDE.md",
    "GUIDE.zh.md"
  ]
}
